<Rive version="1" kind="fragment">
    <!-- Now Playing cover: one artboard for every show. The host app sets colorTop,
         colorBottom and isPlaying on the Cover view model. -->
    <Artboard defaultStateMachineId="0:7" viewModelId="0:40" viewModelInstanceId="0:44"
              clip="true" width="500" height="500" styleId="0:5" name="NowPlaying" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!-- Equalizer: five bars anchored to their base, tallest in the middle. -->
        <Shape x="190" y="400" name="Bar1" id="0:60">
            <Rectangle width="16" height="26" originY="1" cornerRadiusTL="8" name="Path" id="0:61"/>
            <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="Color"/></Fill>
        </Shape>
        <Shape x="220" y="400" name="Bar2" id="0:62">
            <Rectangle width="16" height="52" originY="1" cornerRadiusTL="8" name="Path" id="0:63"/>
