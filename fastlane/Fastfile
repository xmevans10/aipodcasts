default_platform(:ios)

# Zwicky's release lanes.
#
# The Xcode project is generated from ios/project.yml and is git-ignored, so every lane
# regenerates it before building. The build number lives in project.yml
# (CURRENT_PROJECT_VERSION) and is bumped in a commit, not by fastlane editing a pbxproj
# that is about to be overwritten.
#
# Authentication is an App Store Connect API key, supplied through the environment so no
# secret is ever written into this repository:
#
#   export ASC_KEY_ID=XXXXXXXXXX          # the 10-character key id
#   export ASC_ISSUER_ID=xxxxxxxx-xxxx-…  # the team's issuer id (an ASC UUID)
#   export ASC_KEY_PATH=/path/AuthKey_XXXXXXXXXX.p8
#
# ASC keys are issued per team, not per app, so a key already used for another app on
# team 8K5ZVPCQ42 works here.
#
# fastlane loads fastlane/.env on its own, so the values can live there instead of in
# the shell. That file is git-ignored and is read by fastlane directly.

platform :ios do
  before_all do
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] ||= "120"
    # fastlane warns and can mangle output without a UTF-8 locale.
    ENV["LANG"] ||= "en_US.UTF-8"
    ENV["LC_ALL"] ||= "en_US.UTF-8"
  end

  desc "Regenerate the Xcode project from ios/project.yml"
  private_lane :generate_project do
    sh("cd ../ios && xcodegen generate")
  end

  desc "Read the App Store Connect API key from the environment"
  private_lane :asc_key do
    # ASC_KEY_FILE is the name already used by the other apps on this team; the two
    # aliases are accepted so an existing shell export of either name works unchanged.
    key_path = [ENV["ASC_KEY_FILE"], ENV["ASC_API_KEY_PATH"], ENV["ASC_KEY_PATH"]]
               .find { |value| value.to_s != "" }
    missing = %w[ASC_KEY_ID ASC_ISSUER_ID].reject { |name| ENV[name].to_s != "" }
    missing << "ASC_KEY_FILE" if key_path.nil?
    unless missing.empty?
      UI.user_error!("Missing #{missing.join(', ')}. See the header of fastlane/Fastfile.")
    end
    key_path = File.expand_path(key_path)
    UI.user_error!("No .p8 at #{key_path}") unless File.exist?(key_path)
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: key_path,
      in_house: false
    )
  end

  desc "Create the App Store Connect app record if it does not already exist"
  lane :setup_app do
    asc_key
    # Zwicky has never shipped, so there may be no app record to upload against and the
    # first TestFlight upload would fail on an unknown bundle id. `produce` is idempotent:
    # it reports the existing record rather than failing when one is already there.
    produce(
      app_identifier: "com.xmevans10.Zwicky",
      app_name: "Zwicky",
      language: "English (U.S.)",
      sku: "zwicky-ios-001",
      team_id: "8K5ZVPCQ42",
      skip_itc: false,
      skip_devcenter: false
    )
  end

  desc "Build and upload the current commit to TestFlight"
  lane :beta do
    key = asc_key
    generate_project

    build_app(
      project: "ios/Zwicky.xcodeproj",
      scheme: "Zwicky",
      configuration: "Release",
      export_method: "app-store",
      # Use the installed distribution identity and Zwicky App Store profile.
      xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=8K5ZVPCQ42 " \
              "PROVISIONING_PROFILE_SPECIFIER='Zwicky App Store' CODE_SIGN_IDENTITY='Apple Distribution'",
      export_options: {
        signingStyle: "manual",
        teamID: "8K5ZVPCQ42",
        provisioningProfiles: { "com.xmevans10.Zwicky" => "Zwicky App Store" }
      },
      archive_path: "build/fastlane/Zwicky.xcarchive",
      derived_data_path: "build/fastlane/DerivedData",
      build_path: "build/fastlane",
      buildlog_path: "build/fastlane",
      output_directory: "build/fastlane",
      output_name: "Zwicky.ipa",
      clean: true
    )

    upload_to_testflight(
      api_key: key,
      # The build is what we are shipping; waiting on Apple's processing queue can take
      # much longer than the upload and tells us nothing new.
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: ENV["TESTFLIGHT_CHANGELOG"].to_s.empty? ? "App improvements and fixes." : ENV["TESTFLIGHT_CHANGELOG"]
    )
  end

  desc "Everything the repo checks before a release, without shipping"
  lane :checks do
    sh("cd .. && python3 -m pytest -q backend/tests")
    sh("cd .. && ./scripts/run-ios-tests.sh")
    generate_project
    sh("cd .. && xcodebuild -project ios/Zwicky.xcodeproj -scheme Zwicky " \
       "-configuration Release -sdk iphonesimulator " \
       "-destination 'generic/platform=iOS Simulator' build CODE_SIGNING_ALLOWED=NO " \
       "| tail -5")
  end
end
