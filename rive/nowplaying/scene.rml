        </Shape>
        <Shape x="310" y="400" name="Bar5" id="0:68">
            <Rectangle width="16" height="22" originY="1" cornerRadiusTL="8" name="Path" id="0:69"/>
            <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="Color"/></Fill>
        </Shape>

        <!-- Body: a soft sphere that breathes while playing. -->
        <Shape x="250" y="218" name="Pulse" id="0:70">
            <Ellipse width="188" height="188" name="Path" id="0:71"/>
            <Fill name="Fill">
                <LinearGradient startX="-70" startY="-90" endX="80" endY="100" name="Sheen">
                    <GradientStop colorValue="66FFFFFF" position="0"/>
                    <GradientStop colorValue="14FFFFFF" position="1"/>
                </LinearGradient>
            </Fill>
        </Shape>

        <!-- Two orbits, turning slowly in opposite directions. -->
        <Shape x="250" y="218" rotation="-0.45" name="OrbitOuter" id="0:72">
            <Ellipse width="420" height="196" name="Path" id="0:73"/>
            <Stroke thickness="2" name="Stroke"><SolidColor colorValue="3DFFFFFF" name="Color"/></Stroke>
        </Shape>
        <Shape x="250" y="218" rotation="0.32" name="OrbitInner" id="0:74">
            <Ellipse width="322" height="150" name="Path" id="0:75"/>
            <Stroke thickness="2" name="Stroke"><SolidColor colorValue="2EFFFFFF" name="Color"/></Stroke>
        </Shape>

        <!-- Background, declared last so it paints behind everything. -->
        <Shape x="250" y="250" name="Backdrop" id="0:10">
            <Rectangle width="500" height="500" name="Path" id="0:11"/>
            <Fill name="Fill">
                <LinearGradient startX="180" startY="-250" endX="-180" endY="250" name="Gradient">
                    <GradientStop colorValue="FF7D8BE0" position="0" name="Top" id="0:12">
                        <DataBindContext sourcePathIds="0:40-0:41" propertyKey="38"/>
                    </GradientStop>
                    <GradientStop colorValue="FF232B5E" position="1" name="Bottom" id="0:13">
                        <DataBindContext sourcePathIds="0:40-0:42" propertyKey="38"/>
                    </GradientStop>
                </LinearGradient>
            </Fill>
        </Shape>

        <!-- Playing: orbits turn, sphere breathes, bars dance. -->
        <LinearAnimation loopValue="loop" duration="180" name="Playing" id="0:20">
            <KeyedObject objectId="0:72">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="-0.45" interpolationType="linear"/>
                    <KeyFrameDouble value="5.8331855" interpolationType="linear" frame="180"/>
