<Rive version="1" kind="fragment">
    <!-- Now Playing cover: one artboard for every show.
         The app writes colorTop/colorBottom once per episode, and band1..band5 plus
         level every frame from the episode's own audio envelope, so the cover moves
         with the narration rather than looping a canned animation. -->
    <Artboard defaultStateMachineId="0:7" viewModelId="0:40" viewModelInstanceId="0:44"
              clip="true" width="500" height="500" styleId="0:5" name="NowPlaying" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!-- Equalizer: heights follow the five frequency bands. -->
        <Shape x="180" y="408" name="Bar1" id="0:60">
            <Rectangle width="18" height="20" originY="1" cornerRadiusTL="9" name="Path" id="0:61">
                <DataBindContext sourcePathIds="0:40-0:45" propertyKey="21" converterId="0:90"/>
            </Rectangle>
            <Fill name="Fill"><SolidColor colorValue="F2FFFFFF" name="Color"/></Fill>
        </Shape>
        <Shape x="215" y="408" name="Bar2" id="0:62">
            <Rectangle width="18" height="20" originY="1" cornerRadiusTL="9" name="Path" id="0:63">
                <DataBindContext sourcePathIds="0:40-0:46" propertyKey="21" converterId="0:90"/>
            </Rectangle>
            <Fill name="Fill"><SolidColor colorValue="F2FFFFFF" name="Color"/></Fill>
        </Shape>
        <Shape x="250" y="408" name="Bar3" id="0:64">
            <Rectangle width="18" height="20" originY="1" cornerRadiusTL="9" name="Path" id="0:65">
                <DataBindContext sourcePathIds="0:40-0:47" propertyKey="21" converterId="0:90"/>
            </Rectangle>
            <Fill name="Fill"><SolidColor colorValue="F2FFFFFF" name="Color"/></Fill>
        </Shape>
        <Shape x="285" y="408" name="Bar4" id="0:66">
            <Rectangle width="18" height="20" originY="1" cornerRadiusTL="9" name="Path" id="0:67">
                <DataBindContext sourcePathIds="0:40-0:48" propertyKey="21" converterId="0:90"/>
            </Rectangle>
            <Fill name="Fill"><SolidColor colorValue="F2FFFFFF" name="Color"/></Fill>
        </Shape>
        <Shape x="320" y="408" name="Bar5" id="0:68">
            <Rectangle width="18" height="20" originY="1" cornerRadiusTL="9" name="Path" id="0:69">
                <DataBindContext sourcePathIds="0:40-0:49" propertyKey="21" converterId="0:90"/>
            </Rectangle>
            <Fill name="Fill"><SolidColor colorValue="F2FFFFFF" name="Color"/></Fill>
        </Shape>

        <!-- Halo: a soft ring that swells with the overall level. -->
        <Shape x="250" y="214" name="Halo" id="0:76">
            <Ellipse width="250" height="250" name="Path" id="0:77"/>
            <Stroke thickness="26" name="Stroke"><SolidColor colorValue="1FFFFFFF" name="Color"/></Stroke>
            <DataBindContext sourcePathIds="0:40-0:50" propertyKey="16" converterId="0:92"/>
            <DataBindContext sourcePathIds="0:40-0:50" propertyKey="17" converterId="0:92"/>
        </Shape>

        <!-- Body: the sphere breathes with the voice. -->
        <Shape x="250" y="214" name="Pulse" id="0:70">
            <Ellipse width="188" height="188" name="Path" id="0:71"/>
            <Fill name="Fill">
                <LinearGradient startX="-70" startY="-90" endX="80" endY="100" name="Sheen">
                    <GradientStop colorValue="70FFFFFF" position="0"/>
                    <GradientStop colorValue="14FFFFFF" position="1"/>
                </LinearGradient>
            </Fill>
            <DataBindContext sourcePathIds="0:40-0:50" propertyKey="16" converterId="0:91"/>
            <DataBindContext sourcePathIds="0:40-0:50" propertyKey="17" converterId="0:91"/>
        </Shape>

        <!-- Two orbits, always turning. -->
        <Shape x="250" y="214" rotation="-0.45" name="OrbitOuter" id="0:72">
            <Ellipse width="420" height="196" name="Path" id="0:73"/>
            <Stroke thickness="2" name="Stroke"><SolidColor colorValue="3DFFFFFF" name="Color"/></Stroke>
        </Shape>
        <Shape x="250" y="214" rotation="0.32" name="OrbitInner" id="0:74">
            <Ellipse width="322" height="150" name="Path" id="0:75"/>
            <Stroke thickness="2" name="Stroke"><SolidColor colorValue="2EFFFFFF" name="Color"/></Stroke>
        </Shape>

        <!-- Background, declared last so it paints behind everything. -->
        <Shape x="250" y="250" name="Backdrop" id="0:10">
            <Rectangle width="500" height="500" name="Path" id="0:11"/>
            <Fill name="Fill">
                <LinearGradient startX="180" startY="-250" endX="-180" endY="250" name="Gradient">
                    <GradientStop colorValue="FF7D8BE0" position="0" name="Top" id="0:12">
                        <DataBindContext sourcePathIds="0:40-0:41" propertyKey="38"/>
                    </GradientStop>
                    <GradientStop colorValue="FF232B5E" position="1" name="Bottom" id="0:13">
                        <DataBindContext sourcePathIds="0:40-0:42" propertyKey="38"/>
                    </GradientStop>
                </LinearGradient>
            </Fill>
        </Shape>

        <!-- The only timeline: the orbits drift. Everything else is data-driven, and this
             keeps the state machine advancing so each frame's levels are pushed. -->
        <LinearAnimation loopValue="loop" duration="900" name="Drift" id="0:20">
            <KeyedObject objectId="0:72">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="-0.45" interpolationType="linear"/>
                    <KeyFrameDouble value="5.8331855" interpolationType="linear" frame="900"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:74">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="0.32" interpolationType="linear"/>
                    <KeyFrameDouble value="-5.9631855" interpolationType="linear" frame="900"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <StateMachine name="State Machine 1" id="0:7">
            <StateMachineLayer name="Layer 1" id="0:8">
                <AnyState x="520" y="-120"/>
                <ExitState x="700" y="-120"/>
                <EntryState x="20" y="60">
                    <StateTransition stateToId="0:30"/>
                </EntryState>
                <AnimationState x="200" y="60" animationId="0:20" id="0:30"/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <!-- 0..1 level to bar height in points, to sphere scale, to halo scale. -->
    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="20" maxOutput="112"
                              clampLower="true" clampUpper="true" name="ToBarHeight" id="0:90"/>
    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="1" maxOutput="1.11"
                              clampLower="true" clampUpper="true" name="ToPulseScale" id="0:91"/>
    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="0.92" maxOutput="1.3"
                              clampLower="true" clampUpper="true" name="ToHaloScale" id="0:92"/>

    <ViewModel defaultInstanceId="0:44" name="Cover" id="0:40">
        <ViewModelPropertyColor name="colorTop" id="0:41"/>
        <ViewModelPropertyColor name="colorBottom" id="0:42"/>
        <ViewModelPropertyBoolean name="isPlaying" id="0:43"/>
        <ViewModelPropertyNumber name="band1" id="0:45"/>
        <ViewModelPropertyNumber name="band2" id="0:46"/>
        <ViewModelPropertyNumber name="band3" id="0:47"/>
        <ViewModelPropertyNumber name="band4" id="0:48"/>
        <ViewModelPropertyNumber name="band5" id="0:49"/>
        <ViewModelPropertyNumber name="level" id="0:50"/>
        <ViewModelInstance exports="true" name="Default" id="0:44">
            <ViewModelInstanceColor propertyValue="FF7D8BE0" viewModelPropertyId="0:41"/>
            <ViewModelInstanceColor propertyValue="FF232B5E" viewModelPropertyId="0:42"/>
            <ViewModelInstanceBoolean propertyValue="false" viewModelPropertyId="0:43"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:45"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:46"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:47"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:48"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:49"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:50"/>
        </ViewModelInstance>
    </ViewModel>
</Rive>
