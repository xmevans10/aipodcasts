# Provider settings may be placed in backend/.env; never commit real values.
# Deployment variables must be exported or supplied as container environment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_NOVA=
ELEVENLABS_VOICE_FERN=
ELEVENLABS_VOICE_ADA=
ELEVENLABS_VOICE_ATLAS=
LILT_MAX_PROVIDER_CALLS_PER_DAY=12
LILT_MAX_SOURCE_CHARS=18000
LILT_PUBLIC_ORIGIN=https://your-feed-domain.example
# Optional locally; the Docker image uses /data.
# LILT_DATA=/absolute/path/to/lilt-data
PORT=8787

OPENAI_REASONING_EFFORT=low
