# Provider settings may be placed in backend/.env; never commit real values.
# Deployment variables must be exported or supplied as container environment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Two-host dialogue (Ground Truth) uses text-to-dialogue with eleven_v3.
ELEVENLABS_DIALOGUE_MODEL=eleven_v3
# Narration backend: elevenlabs (default), openai, or local (self-hosted HTTP TTS).
VOICE_PROVIDER=elevenlabs
# VOICE_PROVIDER=local: a server accepting {"inputs":[{speaker,text,voice}]} and returning audio.
VOICE_LOCAL_URL=
# VOICE_PROVIDER=openai: preset-voice fallback with no cloning.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_VOICE_NOVA=
ELEVENLABS_VOICE_FERN=
ELEVENLABS_VOICE_ADA=
ELEVENLABS_VOICE_ATLAS=
ELEVENLABS_VOICE_INES=
ELEVENLABS_VOICE_DEV=
LILT_MAX_PROVIDER_CALLS_PER_DAY=12
LILT_MAX_SOURCE_CHARS=18000
LILT_PUBLIC_ORIGIN=https://your-feed-domain.example
# Optional locally; the Docker image uses /data.
# LILT_DATA=/absolute/path/to/lilt-data
PORT=8787

OPENAI_REASONING_EFFORT=low
# OpenAlex free key for autonomous selection (https://openalex.org); raises rate limits
LILT_OPENALEX_KEY=
LILT_CONTACT_EMAIL=
# Jev (TypeSafe System One) typed-decision verifier: https://typesafe.ai
TYPESAFE_AI_API_KEY=
